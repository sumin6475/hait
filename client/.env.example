# 서버 URL
# - 로컬 개발: http://localhost:3001
# - 배포: https://hait-server.up.railway.app (또는 너의 Railway 도메인)
VITE_SERVER_URL=http://localhost:3001

# Admin 인증 토큰 (서버 .env의 ADMIN_TOKEN과 일치해야 함)
VITE_ADMIN_TOKEN=hait-dev-token-2026

# Qualtrics 설문 URL
# 실제 URL 생기면 교체. participantCode는 ?ParticipantCode= 으로 자동 전달됨.
# POSTSURVEY는 &Condition=(C1~C4|CTRL)도 자동 전달 — Qualtrics 분기 로직이 CTRL이면 AI 섹션을 숨김.
VITE_QUALTRICS_CONSENT_URL=https://qualtrics.com/CHANGE_ME_CONSENT
VITE_QUALTRICS_DEMOGRAPHICS_URL=https://qualtrics.com/CHANGE_ME_DEMOGRAPHICS
VITE_QUALTRICS_POSTSURVEY_URL=https://qualtrics.com/CHANGE_ME_POSTSURVEY