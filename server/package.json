{
  "name": "hait-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "eval": "tsx src/scripts/eval-scenarios.ts",
    "golden": "tsx src/eval/run-golden.ts",
    "judge:cases": "tsx src/eval/run-unified-judge.ts",
    "judge:legacy": "tsx src/eval/run-judge.ts",
    "observer:cases": "tsx src/eval/run-observer.ts",
    "eval:conversation:prepare": "tsx src/eval/prepare-conversation-corpus.ts",
    "eval:conversation:prepare-gold": "tsx src/eval/prepare-conversation-gold.ts",
    "eval:conversation:label-turn": "tsx src/eval/show-conversation-label-turn.ts",
    "eval:conversation:validate-gold": "tsx src/eval/validate-conversation-gold.ts",
    "eval:conversation:smoke": "tsx src/eval/run-conversation-controller-smoke.ts",
    "eval:traits:corpus": "tsx src/eval/run-trait-extractor-corpus.ts",
    "uptake:cases": "tsx src/eval/run-uptake.ts",
    "eval:followup": "tsx src/eval/run-followup.ts",
    "test:seq": "tsx src/scripts/test-seq-atomic.ts",
    "test:conversation-recovery": "tsx src/scripts/test-conversation-recovery.ts",
    "test:conversation-ledger": "tsx src/scripts/test-conversation-ledger.ts",
    "test:conversation-gold": "tsx src/scripts/test-conversation-gold.ts",
    "test:pooling-extractor": "tsx src/scripts/test-pooling-extractor.ts",
    "prompts:import": "node scripts/import-route-prompts.mjs",
    "prompts:compile": "tsx scripts/compile-route-prompts.ts",
    "test:intervention-v2": "npm run build --silent && node dist/scripts/test-intervention-v2.js",
    "docs:check": "tsx src/scripts/check-docs.ts",
    "report:budget": "tsx src/scripts/report-reveal-budget.ts",
    "build:id": "node scripts/build-id.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "openai": "^6.38.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "js-yaml": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
