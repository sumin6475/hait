{
  "name": "hait-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "eval": "tsx src/scripts/eval-scenarios.ts",
    "golden": "tsx src/eval/run-golden.ts",
    "judge:cases": "tsx src/eval/run-judge.ts",
    "eval:followup": "tsx src/eval/run-followup.ts",
    "test:seq": "tsx src/scripts/test-seq-atomic.ts",
    "prompts:import": "node scripts/import-route-prompts.mjs",
    "prompts:compile": "node scripts/compile-route-prompts.mjs",
    "test:intervention-v2": "npm run build --silent && node dist/scripts/test-intervention-v2.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "openai": "^6.38.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "js-yaml": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
