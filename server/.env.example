PORT=3001
MONGODB_URI=mongodb://localhost:27017/hait
OPENAI_API_KEY=sk-your-key-here
# U-M GPT Toolkit 게이트웨이 (상용 OpenAI 직접 호출 시엔 비워두면 SDK 기본값 사용)
OPENAI_API_BASE=https://api.toolkit.umgpt.umich.edu/v1
ADMIN_TOKEN=hait-dev-token-2026

# off | shadow | active. Active is the normal path: Observer output is reduced
# into the ledger and consumed by the live controller. shadow/off are rollback modes.
CONVERSATION_OBSERVER_MODE=active

# legacy | ledger_shadow | ledger_active. ledger_active is the normal path.
# legacy and ledger_shadow are available only for rollback/comparison.
CONVERSATION_CONTROLLER_MODE=ledger_active

# Vercel 등 프론트 origin (콤마 구분, 슬래시 없이)
# 예: https://hait-blue.vercel.app,http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# ── Comparison-run guard flags ────────────────────────────────────────────────
# Each switches OFF a check that can cost Alex a turn, so a session can be run
# twice and the two transcripts compared. Every one defaults to ON: leave it
# unset for a normal session. Accepted "off" values: off | 0 | false | no.
# Whichever are off is written into every intervention row (`disabledGuards`)
# and announced at startup, so a comparison transcript can never be mistaken for
# an ordinary one.
#
# HAIT_GUARD_OUTPUT_SCOPE=off   # broadcast a message that names a fact outside the Judge's list
# HAIT_GUARD_COOLDOWN=off       # let Alex take consecutive turns
# HAIT_GUARD_HUMAN_FLOOR=off    # let Alex speak while a human still holds the floor
# HAIT_GUARD_JUDGE_BRIEF=off    # keep a decision whose brief is missing or too long
